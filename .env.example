# LiveKit target
LK_URL=wss://livekit.example.com
LK_ROOM=robot-room-1
LK_IDENTITY=robot-streamer-1
LK_NAME=Robot Streamer 1
LK_TRACK_NAME=camera

# Input stream from ffmpeg (TCP Annex-B H.264)
INPUT_LISTEN_ADDR=127.0.0.1:5004
VIDEO_FPS=30
INPUT_READ_TIMEOUT_MS=500
FRAME_FLUSH_TIMEOUT_MS=50
ALLOW_REMOTE_INPUT=false

# Low-latency queue and publish behavior
FRAME_CHAN_SIZE=4
MAX_PUBLISH_STALE_MS=250
AU_MAX_NALUS=64
AU_MAX_BYTES=2097152
METRICS_INTERVAL_MS=5000
METRICS_STATE_FILE=

# Local health and Prometheus metrics endpoint
HEALTH_ADDR=127.0.0.1:9090
HEALTH_AUTH_TOKEN=
ALLOW_REMOTE_HEALTH=false

# Option A: static short-lived token injected by supervisor
# LK_TOKEN=

# Option A2: file containing a short-lived token
# TOKEN_FILE=

# Option B: token endpoint (recommended)
TOKEN_ENDPOINT=http://127.0.0.1:8088/token
TOKEN_AUTH_BEARER=
DEVICE_ID=robot-1
DEVICE_SECRET=replace-with-strong-secret
TOKEN_TIMEOUT_MS=3000
TOKEN_TTL_SECONDS=300

# Reconnect policy
RECONNECT_MIN_MS=500
RECONNECT_MAX_MS=8000

# Optional env-style configuration file. Existing environment values win.
# CONFIG_FILE=/etc/default/botparty-streamer
