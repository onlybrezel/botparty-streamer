[Unit]
Description=BotParty LiveKit H264 Publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/botparty-streamer
WorkingDirectory=/opt/botparty-streamer
ExecStart=/usr/local/bin/botparty-streamer
Restart=always
RestartSec=1
User=botparty
Group=botparty
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
