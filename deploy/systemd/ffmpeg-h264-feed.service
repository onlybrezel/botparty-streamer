[Unit]
Description=FFmpeg H264 Feed for botparty-streamer
After=network-online.target botparty-streamer.service
Wants=network-online.target botparty-streamer.service

[Service]
Type=simple
EnvironmentFile=/etc/default/ffmpeg-h264-feed
ExecStart=/bin/bash -lc "$FFMPEG_CMD"
Restart=always
RestartSec=1
User=botparty
Group=botparty
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
